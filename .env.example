# Local standalone Sandbox service. Keep secrets in the ignored .env.
DATABASE_URL=postgresql+psycopg://payments:change-me@127.0.0.1:54329/payments
POSTGRES_PASSWORD=change-me
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
LOG_LEVEL=INFO
# AUTH_USERS maps a staff name to {"password_hash":"<Argon2 hash>"}.
# API_KEYS maps an integration name to {"sha256":"<64-character SHA-256 hash>"}.
# All authenticated identities have the same access. No raw passwords/tokens here.
AUTH_USERS={}
API_KEYS={}
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:8100"]
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_RETURN_URL=http://localhost:8100/paypal/success
PAYPAL_CANCEL_URL=http://localhost:8100/paypal/fail
LIVE_ENABLED=false
MAXIMUM_AMOUNT=1000000.00
# Ordinary provider-managed subscription billing; the service never charges renewals.
AUTO_BILL_OUTSTANDING=false
PAYMENT_FAILURE_THRESHOLD=2
