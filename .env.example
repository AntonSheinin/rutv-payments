# Copy to .env.dev for local Sandbox use; .env.prod is the separate live profile.
# Every application setting is required, including explicitly empty values.
# These example credentials must be replaced. Never commit .env.dev or .env.prod.

# The only database setting. Choose a random password once; Compose and the API share it.
# Host db, port 5432, username payments and database payments are fixed in code/Compose.
POSTGRES_PASSWORD=change-me
# Private random signing secret, at least 32 characters; use different secrets per environment.
APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Application logging verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# Username-to-Argon2-hash JSON. Single quotes preserve dollar signs; no raw passwords.
AUTH_USERS='{}'
# Integration-name-to-lowercase-SHA-256-hash JSON. Raw tokens belong to calling services.
# At least one AUTH_USERS or API_KEYS entry is required; every identity has the same access.
API_KEYS='{}'
# Comma-separated browser source IPv4/IPv6 addresses, e.g. 62.90.52.94,203.0.113.10.
# Empty disables this restriction in Sandbox; live staff access requires at least one IP.
# Pydantic validates each address. Valid API keys bypass this restriction.
ALLOWED_IPS=
# HTTPS-only session cookies: false for local HTTP, true for production HTTPS.
COOKIE_SECURE=false
# Comma-separated exact browser origins, e.g. https://payments.rutv.co.il,http://localhost:8100.
# Each origin includes scheme, host and optional port; no paths, queries or credentials.
ALLOWED_ORIGINS=http://localhost:8100
# Selects the PayPal API and browser label; live enables real payments.
# Values: sandbox or live. Keep credentials and databases separate.
PAYPAL_ENVIRONMENT=sandbox
# PayPal REST application client ID for the selected environment; empty disables Sandbox checkout.
PAYPAL_CLIENT_ID=
# Private PayPal REST application secret for the selected environment.
PAYPAL_CLIENT_SECRET=
# Merchant identity that provider financial facts must match.
PAYPAL_MERCHANT_ID=
# Subscription approval return URL; the backend appends its signed checkout state.
PAYPAL_RETURN_URL=http://localhost:8100/paypal/success
# Subscription cancellation return URL; use the production HTTPS hostname in the live profile.
PAYPAL_CANCEL_URL=http://localhost:8100/paypal/fail
# Maximum allowed amount for a single payment/billing interval; positive decimal text.
MAXIMUM_AMOUNT=1000000.00
# Whether PayPal adds unpaid subscription balances to the next scheduled bill.
AUTO_BILL_OUTSTANDING=false
# Consecutive failed subscription payments before suspension; integer from 0 through 999.
PAYMENT_FAILURE_THRESHOLD=2
# Uvicorn trusted proxy peer IPs, comma separated; Pydantic validates every address.
# Empty trusts no forwarded headers. Wildcards and network ranges are rejected.
# Production: verify the host Nginx peer address. Never use * or trust all peer containers.
FORWARDED_ALLOW_IPS=
